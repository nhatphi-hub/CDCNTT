# Mau cau hinh local: dien gia tri cho ca bon bien bat buoc.
# Khong co credential/key mac dinh. Khong commit file .env da dien.
# Spring Boot KHONG tu dong doc .env; xem docs/security-configuration.md.

# JDBC PostgreSQL URL, khong chua username/password trong URL.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# Base64 chuan cua khoa ngau nhien, it nhat 32 byte sau decode.
JWT_SECRET=

# Integration only: use a separately provisioned disposable PostgreSQL database.
# Never point TEST_DB_URL to the development/demo database. These are optional
# documentation placeholders, not credentials; do not uncomment until prepared.
# TEST_DB_URL=jdbc:postgresql://localhost:5432/smart_ecommerce_test_ppee
# TEST_DB_USERNAME=ppee_test_runner
# TEST_DB_PASSWORD=

# Tuy chon: so nguyen duong theo millisecond. Mac dinh 86400000 (24 gio).
# JWT_EXPIRATION_MS=<SO_NGUYEN_DUONG_MILLISECOND>

# Tuy chon: exact frontend origins phan tach bang dau phay, khong dung '*'.
# CORS_ALLOWED_ORIGINS=<EXACT_ORIGINS_COMMA_SEPARATED>

# Google OAuth Web Client ID (public); match frontend/web/index.html.
GOOGLE_CLIENT_ID=230900237413-4psssq06jtftg2g85lcab9d5smfr9sp4.apps.googleusercontent.com
